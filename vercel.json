{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "regions": ["iad1"],
  "functions": { "api/index.ts": { "maxDuration": 60 } },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api" },
    { "handle": "filesystem" },
    { "src": "/(?!api(?:/|$)|assets(?:/|$)).*", "dest": "/index.html" }
  ]
}
