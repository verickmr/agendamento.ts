{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", "**/.env", "api/**"],
  "globalEnv": [
    "DATABASE_URL",
    "VERCEL",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "TEST_DATABASE_URL",
    "SESSION_SECRET",
    "FRONTEND_ORIGIN",
    "NODE_ENV",
    "PORT",
    "HOST",
    "API_PROXY_TARGET",
    "ALLOWED_ORIGINS",
    "TRUST_PROXY",
    "SEED_EMAIL",
    "SEED_PASSWORD",
    "SEED_NAME"
  ],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "outputs": ["dist/**"] },
    "@serena/backend#build": { "dependsOn": ["db:generate"], "outputs": ["dist/**"] },
    "@serena/backend#dev": { "dependsOn": ["db:generate"], "cache": false, "persistent": true },
    "typecheck": { "outputs": [] },
    "@serena/backend#typecheck": { "dependsOn": ["db:generate"], "outputs": [] },
    "test": { "outputs": [] },
    "@serena/backend#test": { "dependsOn": ["db:generate"], "outputs": [] },
    "@serena/backend#test:integration": { "dependsOn": ["db:generate"], "cache": false },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false },
    "db:seed": { "dependsOn": ["db:generate"], "cache": false }
  }
}
